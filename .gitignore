# macOS
.DS_Store

# Environment and secrets
.env
.env.*
!.env.example
!.env.local.example.deepseek
*.pem
*.key

# JavaScript / TypeScript
node_modules/
.next/
dist/
build/
coverage/
.turbo/
.pnpm-store/
/output/playwright/
/output/provider-canary/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Editors（只跟踪 .vscode/settings.json 和 extensions.json；治理门禁会拒绝其余个人状态）
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# Claude Code — 共享团队配置，保留个人覆盖
# .claude/ 下默认全部忽略，仅白名单共享 settings.json、commands/、rules/、skills/、agents/
.claude/*
!.claude/settings.json
!.claude/commands/
!.claude/rules/
!.claude/skills/
!.claude/agents/
.claude/settings.local.json
CLAUDE.local.md

# Logs and temporary files
*.log
logs/
tmp/
temp/
.educanvas-local.pid
.educanvas-migrate-state.json
.omx/
.omo/

# Local runtime data and large generated artifacts
# 注意：只匹配仓库根目录，避免误伤 packages/canvas-protocol/src/artifacts/ 等源码目录
/uploads/
/models/
/checkpoints/
/artifacts/

# TypeScript incremental build info
*.tsbuildinfo

# 个人学习笔记
notes/

# RAG 评测本地报告（生成产物，不入仓）
tooling/evals/reports/
