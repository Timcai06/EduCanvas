# Copy this file to .env and fill in local values. Never commit .env.

# Local PostgreSQL. Compose publishes container port 5432 on host port 5434 by default;
# For a parallel worktree, pass EDUCANVAS_POSTGRES_PORT to setup and align DATABASE_URL, for example:
# EDUCANVAS_POSTGRES_PORT=5435 DATABASE_URL=postgresql://educanvas:educanvas@127.0.0.1:5435/educanvas pnpm setup:local
DATABASE_URL=postgresql://educanvas:educanvas@127.0.0.1:5434/educanvas

# Model provider adapter. Disabled by default; never put a real key here.
EDUCANVAS_DEPLOYMENT_ENV=local
MODEL_GATEWAY_PROVIDER=
# Turn adapter: native (default) or ai-sdk; no silent fallback.
MODEL_GATEWAY_RUNTIME=native
MODEL_GATEWAY_ALLOW_DEEPSEEK=false
MODEL_GATEWAY_BASE_URL=
MODEL_GATEWAY_API_KEY=

# Model IDs must be configured explicitly; provider model names are not bundled.
MODEL_GATEWAY_PRIMARY_MODEL=
MODEL_GATEWAY_FAST_MODEL=
MODEL_GATEWAY_STRUCTURED_MODEL=
# Per-capability provider override (ADR-0021): each media capability can declare
# an independent provider, endpoint and credential instead of inheriting the
# primary provider's. Declaring MODEL_GATEWAY_<CAP>_PROVIDER makes the MODEL,
# BASE_URL and API_KEY of that capability mandatory as one complete group;
# a half-configured override is rejected rather than silently ignored. Leaving
# the provider empty inherits the primary provider when it supports the
# capability, and disables the capability otherwise.
MODEL_GATEWAY_SPEECH_PROVIDER=
MODEL_GATEWAY_SPEECH_MODEL=
MODEL_GATEWAY_SPEECH_BASE_URL=
MODEL_GATEWAY_SPEECH_API_KEY=
MODEL_GATEWAY_SPEECH_VOICE=alloy
MODEL_GATEWAY_SPEECH_TIMEOUT_MS=60000
MODEL_GATEWAY_SPEECH_MAX_INPUT_CHARS=3500
MODEL_GATEWAY_TRANSCRIPTION_PROVIDER=
MODEL_GATEWAY_TRANSCRIPTION_MODEL=
MODEL_GATEWAY_TRANSCRIPTION_BASE_URL=
MODEL_GATEWAY_TRANSCRIPTION_API_KEY=
MODEL_GATEWAY_TRANSCRIPTION_TIMEOUT_MS=120000
MODEL_GATEWAY_TRANSCRIPTION_MAX_INPUT_BYTES=26214400
# Leaving MODEL_GATEWAY_IMAGE_MODEL empty keeps the generateCanvasImage tool
# unregistered: the capability never enters the tool policy, so the model does
# not see it and cannot claim it can draw. See ADR-0014.
MODEL_GATEWAY_IMAGE_PROVIDER=
MODEL_GATEWAY_IMAGE_MODEL=
MODEL_GATEWAY_IMAGE_BASE_URL=
MODEL_GATEWAY_IMAGE_API_KEY=
MODEL_GATEWAY_IMAGE_TIMEOUT_MS=120000
MODEL_GATEWAY_IMAGE_MAX_OUTPUT_BYTES=8388608
# Leaving MODEL_GATEWAY_EMBEDDING_MODEL empty keeps retrieval on pure full-text
# search: hybrid retrieval degrades honestly instead of returning nothing.
# The version is mandatory once a model is set — vectors from a silently
# re-trained model must not be treated as comparable. See ADR-0015.
MODEL_GATEWAY_EMBEDDING_PROVIDER=
MODEL_GATEWAY_EMBEDDING_MODEL=
MODEL_GATEWAY_EMBEDDING_BASE_URL=
MODEL_GATEWAY_EMBEDDING_API_KEY=
MODEL_GATEWAY_EMBEDDING_MODEL_VERSION=
MODEL_GATEWAY_EMBEDDING_TIMEOUT_MS=60000
MODEL_GATEWAY_EMBEDDING_MAX_BATCH=64
MODEL_GATEWAY_TIMEOUT_MS=120000
MODEL_GATEWAY_MAX_OUTPUT_TOKENS=2048
# Canvas JSON includes nodes, edges and presentation metadata; keep its budget
# independent from ordinary chat so large artifacts are not truncated midway.
MODEL_GATEWAY_STRUCTURED_MAX_OUTPUT_TOKENS=8192
# Set to true only when MODEL_GATEWAY_PRIMARY_MODEL can actually read image pixels.
# Left false, images are still stored and previewed but a turn that references one
# fails with a clear message instead of being sent to a text-only model.
MODEL_GATEWAY_VISION=false
# Send thinking:{type:disabled} to the primary provider. DeepSeek always has it
# disabled by protocol and ignores this flag; set it for other providers that
# default to thinking. See ADR-0017.
MODEL_GATEWAY_DISABLE_THINKING=false

# Separate vision provider for image input, used when the primary model is
# text-only (DeepSeek has no vision capability). Setting the model declares the
# provider exists, which makes the base URL and key mandatory: a half-configured
# vision provider would look available until a student actually attaches an
# image. Mutually exclusive with MODEL_GATEWAY_VISION above — declaring both
# expresses two contradictory expectations about where images go. Only turns
# that actually carry an image route here; everything else stays on the primary
# provider. See ADR-0017.
#
# Zhipu GLM example (glm-4.6v-flash is free, 128K context, native tool calls):
#   MODEL_GATEWAY_VISION_MODEL=glm-4.6v-flash
#   MODEL_GATEWAY_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   MODEL_GATEWAY_VISION_DISABLE_THINKING=true
# The base URL is the API endpoint, not the console page you copy the key from.
MODEL_GATEWAY_VISION_MODEL=
MODEL_GATEWAY_VISION_BASE_URL=
MODEL_GATEWAY_VISION_API_KEY=
MODEL_GATEWAY_VISION_TIMEOUT_MS=120000
MODEL_GATEWAY_VISION_MAX_OUTPUT_TOKENS=2048
# Send thinking:{type:disabled}. EduCanvas discards CoT, so reasoning tokens are
# paid for and thrown away — GLM-4.6V spent 24 of 31 output tokens on discarded
# reasoning until this was set, and a small max_tokens leaves the answer empty.
# Off by default: the field is not part of the OpenAI protocol and providers that
# do not recognise it reject the whole turn. See ADR-0017.
MODEL_GATEWAY_VISION_DISABLE_THINKING=false

# Video source processing runs ffmpeg/ffprobe in the worker process only. The
# binaries are not bundled: they are platform-specific and licence-encumbered.
# Leave these empty to use whatever is on PATH; when neither is available, video
# uploads terminate with video_toolchain_unavailable and nothing else changes.
# See ADR-0016.
EDUCANVAS_FFMPEG_PATH=
EDUCANVAS_FFPROBE_PATH=

# OpenTelemetry is disabled by default; exported data never includes prompts, tokens, or secrets.
EDUCANVAS_OTEL_ENABLED=false
EDUCANVAS_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# Optional controlled headers JSON; keep real tokens in local secrets only.
EDUCANVAS_OTEL_EXPORTER_HEADERS_JSON=
EDUCANVAS_OTEL_SAMPLE_RATIO=0.1
EDUCANVAS_OTEL_EXPORT_TIMEOUT_MS=3000

# MinerU document structure conversion (ADR-0026): PDF/DOCX/PPTX/XLSX uploads
# are routed to this service for structured Markdown extraction. Leave empty
# to disable — document uploads then degrade to plain-text extraction
# (quality degraded_plain_text) and nothing else changes. Plain URL, no API
# key; run it on loopback or an internal network you control.
MINERU_BASE_URL=
# Optional: hybrid-engine (default, higher fidelity) or pipeline (lower GPU demand).
MINERU_BACKEND=

# Web search tool (WS02): Tavily and self-hosted SearXNG are independently
# optional; when both are configured, Tavily is attempted first.
SEARCH_API_KEY=
# Optional; defaults to https://api.tavily.com
SEARCH_BASE_URL=
# Optional SearXNG JSON endpoint base URL; API key depends on deployment policy.
SEARXNG_BASE_URL=
SEARXNG_API_KEY=

# Gateway. Listens on loopback by default; tokens/secrets must be at least 32 bytes.
# Without auth values, only health checks and internal shutdown are available.
EDUCANVAS_GATEWAY_HOST=127.0.0.1
EDUCANVAS_GATEWAY_PORT=3200
# CA02 acknowledgement-gap repair: enabled (default) or legacy-disabled rollback.
EDUCANVAS_GATEWAY_TERMINAL_RECONCILIATION_MODE=enabled
EDUCANVAS_GATEWAY_URL=http://127.0.0.1:3200
EDUCANVAS_GATEWAY_INTERNAL_TOKEN=
EDUCANVAS_GATEWAY_BOOTSTRAP_TOKEN=
EDUCANVAS_GATEWAY_SESSION_SECRET=
# Native desktop sign-in opens the Web authorization page in the system browser,
# then sends assistant traffic directly to Gateway. Production values must use HTTPS.
EDUCANVAS_DESKTOP_WEB_URL=http://127.0.0.1:3000
EDUCANVAS_DESKTOP_GATEWAY_URL=http://127.0.0.1:3200
# Shared local Web/TUI development identity; loopback onboarding only.
EDUCANVAS_LOCAL_USER_ID=local:owner
# Browser origins allowed to open the realtime voice WebSocket (strict
# allowlist, comma-separated, http(s)://host[:port], no paths/credentials).
# Unset defaults to the local Web origin (127.0.0.1/localhost:3000).
EDUCANVAS_GATEWAY_WS_ALLOWED_ORIGINS=
# Live Voice（阿里云百炼华北 2）；缺失时仅关闭 Live，不影响 Dictation/文字聊天。
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_BEIJING_WS_URL=
DASHSCOPE_ASR_MODEL=paraformer-realtime-v2
DASHSCOPE_DICTATION_MODEL=qwen3-asr-flash
DASHSCOPE_TTS_MODEL=qwen-audio-3.0-tts-flash
DASHSCOPE_TTS_VOICE=longanhuan_v3.6
# Realtime streaming-transcription resource quotas (V13). All are optional;
# unset uses conservative classroom-scaled defaults. Any invalid value makes
# startup fail (fail-closed). Values: user connection cap, user+notebook cap,
# global active session cap, per-connection duration ms, idle ms, cumulative
# PCM bytes, chunk count, queued input messages, output buffered bytes.
EDUCANVAS_GATEWAY_STREAMING_MAX_CONNECTIONS_PER_USER=
EDUCANVAS_GATEWAY_STREAMING_MAX_CONNECTIONS_PER_NOTEBOOK=
EDUCANVAS_GATEWAY_STREAMING_MAX_CONNECTIONS_GLOBAL=
EDUCANVAS_GATEWAY_STREAMING_MAX_ACTIVE_SESSIONS_GLOBAL=
EDUCANVAS_GATEWAY_STREAMING_MAX_SESSION_DURATION_MS=
EDUCANVAS_GATEWAY_STREAMING_MAX_SESSION_IDLE_MS=
EDUCANVAS_GATEWAY_STREAMING_MAX_PCM_BYTES_PER_CONNECTION=
EDUCANVAS_GATEWAY_STREAMING_MAX_CHUNKS_PER_CONNECTION=
EDUCANVAS_GATEWAY_STREAMING_MAX_QUEUED_INPUT_MESSAGES=
EDUCANVAS_GATEWAY_STREAMING_MAX_OUTPUT_BUFFERED_BYTES=
# Migration rollout only: create new K12 platform-message copies. Settle always
# converges copies that already exist, including across deployment flag changes.
EDUCANVAS_K12_CONVERSATION_DUAL_WRITE=false
# K12 visible-history authority, frozen when the Web process starts. legacy
# (default) and observe read chat_messages; platform reads verified platform
# projections while retaining legacy runtime metadata. Roll back to legacy and
# restart. Never enable platform before a full zero-difference audit.
EDUCANVAS_K12_CONVERSATION_AUTHORITY_STAGE=legacy

# Telegram username for control-plane deep links; the bot token is adapter-only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Capability Node read-only root mapping, for example {"notes":"/Users/me/Notes"}.
# Node supports controlled list/read only; it has no shell or write capability.
EDUCANVAS_NODE_READ_ROOTS_JSON={}

# Trusted MCP v1 Streamable HTTP registrations. Disabled by default; never put tokens here.
# Bearer tools must use opaque handles resolved by an independent Credential Broker.
EDUCANVAS_MCP_TOOLS_JSON=[]
# Required only for L2/L3 MCP; inject a random 32-byte base64 secret at deployment time.
EDUCANVAS_MCP_INTENT_ENCRYPTION_KEY=

# 仅用于受控测试/竞赛演示；留空时首次打开必须选择 general 或 restricted。
# restricted 仍允许瞬时云端识别，但原始音频不落盘。
EDUCANVAS_EXPERIENCE_MODE_DEFAULT=
