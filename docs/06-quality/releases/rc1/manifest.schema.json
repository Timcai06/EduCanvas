{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Release Evidence Manifest",
  "description": "Machine-readable manifest for release evidence validation",
  "type": "object",
  "required": ["release", "version", "status", "baseline", "gates"],
  "properties": {
    "release": {
      "type": "string",
      "description": "Release identifier (e.g., rc1, rc2, v1.0)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-\\w+)?$",
      "description": "Semantic version"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in-progress", "passed", "failed", "blocked"],
      "description": "Overall release status"
    },
    "baseline": {
      "type": "object",
      "required": ["sha", "branch", "timestamp"],
      "properties": {
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Git SHA of baseline commit"
        },
        "branch": {
          "type": "string",
          "description": "Branch name"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp"
        }
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "description": "Current migration version"
        },
        "fresh": {
          "type": "object",
          "properties": {
            "status": { "$ref": "#/definitions/gateStatus" },
            "timestamp": { "type": "string", "format": "date-time" }
          }
        },
        "upgrade": {
          "type": "object",
          "properties": {
            "status": { "$ref": "#/definitions/gateStatus" },
            "timestamp": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "description": "CI gate results",
      "properties": {
        "lint": { "$ref": "#/definitions/gate" },
        "typecheck": { "$ref": "#/definitions/gate" },
        "unit": { "$ref": "#/definitions/gate" },
        "db-integration": { "$ref": "#/definitions/gate" },
        "worker-integration": { "$ref": "#/definitions/gate" },
        "build": { "$ref": "#/definitions/gate" },
        "e2e": { "$ref": "#/definitions/gate" },
        "security": { "$ref": "#/definitions/gate" },
        "contract": { "$ref": "#/definitions/gate" },
        "eval": { "$ref": "#/definitions/gate" },
        "provider-smoke": { "$ref": "#/definitions/gate" },
        "release-evidence": { "$ref": "#/definitions/gate" }
      }
    },
    "provider": {
      "type": "object",
      "properties": {
        "config": { "type": "object" },
        "summary": { "type": "string" }
      }
    },
    "eval": {
      "type": "object",
      "properties": {
        "retrieval": { "$ref": "#/definitions/evalResult" },
        "tool-artifact": { "$ref": "#/definitions/evalResult" },
        "teaching-safety": { "$ref": "#/definitions/evalResult" }
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "cost": { "$ref": "#/definitions/budgetItem" },
        "latency": { "$ref": "#/definitions/budgetItem" },
        "error_rate": { "$ref": "#/definitions/budgetItem" }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "severity"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "mitigation": { "type": "string" }
        }
      }
    },
    "signoffs": {
      "type": "object",
      "properties": {
        "security": { "$ref": "#/definitions/signoff" },
        "product": { "$ref": "#/definitions/signoff" },
        "engineering": { "$ref": "#/definitions/signoff" }
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "baseline": { "type": "string" },
        "gates": { "type": "string" },
        "eval": { "type": "string" },
        "dogfood": { "type": "string" },
        "drills": { "type": "string" }
      }
    }
  },
  "definitions": {
    "gateStatus": {
      "type": "string",
      "enum": ["pending", "running", "passed", "failed", "skipped"]
    },
    "gate": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/definitions/gateStatus" },
        "timestamp": { "type": "string", "format": "date-time" },
        "output": { "type": "string" },
        "total": { "type": "integer" },
        "passed": { "type": "integer" }
      }
    },
    "evalResult": {
      "type": "object",
      "properties": {
        "status": { "$ref": "#/definitions/gateStatus" },
        "baseline": { "type": "object" }
      }
    },
    "budgetItem": {
      "type": "object",
      "properties": {
        "limit": { "type": "number" },
        "actual": { "type": "number" },
        "status": { "$ref": "#/definitions/gateStatus" }
      }
    },
    "signoff": {
      "type": "object",
      "properties": {
        "signed": { "type": "boolean" },
        "by": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  }
}
