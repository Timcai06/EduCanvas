# Local DeepSeek development overlay. Merge these values into .env; never commit a real key.
# 型号说明：旧 deepseek-chat / deepseek-reasoner 已于 2026-07-24 15:59 UTC 停止服务，
# 当前候选为 deepseek-v4-flash（非思考模式对应旧 deepseek-chat）与 deepseek-v4-pro。
# 供应商型号只允许出现在部署配置里，代码中不设默认值（见 docs/03-ai/model-routing.md）。
EDUCANVAS_DEPLOYMENT_ENV=local
MODEL_GATEWAY_PROVIDER=deepseek
MODEL_GATEWAY_RUNTIME=native
MODEL_GATEWAY_ALLOW_DEEPSEEK=true
MODEL_GATEWAY_BASE_URL=https://api.deepseek.com
MODEL_GATEWAY_API_KEY=<your-deepseek-api-key>
MODEL_GATEWAY_PRIMARY_MODEL=deepseek-v4-flash
MODEL_GATEWAY_FAST_MODEL=deepseek-v4-flash
MODEL_GATEWAY_STRUCTURED_MODEL=deepseek-v4-flash

# DeepSeek 没有视觉能力，图片输入需要另配视觉 Provider（ADR-0017）。
# 变量与示例取值见 .env.example 中的 MODEL_GATEWAY_VISION_* 一节。
