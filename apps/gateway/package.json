{
  "name": "@educanvas/gateway",
  "version": "0.1.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --external:drizzle-orm --external:drizzle-orm/* --external:postgres --external:zod --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/index.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@educanvas/agent-core": "workspace:*",
    "@educanvas/agent-runtime": "workspace:*",
    "@educanvas/canvas-protocol": "workspace:*",
    "@educanvas/db": "workspace:*",
    "@educanvas/gateway-core": "workspace:*",
    "@educanvas/gateway-runtime": "workspace:*",
    "@educanvas/logging": "workspace:*",
    "@educanvas/mcp-runtime": "workspace:*",
    "@educanvas/model-gateway": "workspace:*",
    "@educanvas/node-runtime": "workspace:*",
    "@educanvas/telemetry": "workspace:*",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.27.3",
    "postgres": "^3.4.9",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
