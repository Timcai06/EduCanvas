{
  "name": "@educanvas/desktop",
  "version": "0.1.0",
  "description": "EduCanvas first-party desktop companion",
  "author": "EduCanvas Contributors",
  "engines": {
    "node": ">=24.18.0"
  },
  "private": true,
  "main": "out/main/index.js",
  "dependencies": {
    "@educanvas/gateway-client": "workspace:*",
    "@educanvas/gateway-core": "workspace:*"
  },
  "scripts": {
    "predev": "node scripts/ensure-electron.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "gen:pet-sprites": "node scripts/generate-pet-sprites.mjs",
    "typecheck": "tsc --noEmit",
    "audit:windows-package": "node scripts/audit-windows-package.mjs",
    "package:portable": "electron-vite build && electron-builder --win portable && pnpm run audit:windows-package",
    "package:windows": "electron-vite build && electron-builder --win nsis portable && pnpm run audit:windows-package"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
