{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://educanvas.local/schemas/provider-canary-input-v1.json",
  "title": "EduCanvas protected Provider canary input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetVersion",
    "turnsPerScenario",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "datasetVersion": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "turnsPerScenario": { "type": "integer", "minimum": 1, "maximum": 2 },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
