{
  "name": "@educanvas/voice-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voice lab for reproducible sherpa-onnx native and WASM comparisons",
  "scripts": {
    "test": "node --test test-v02-s-evaluation.mjs test-v02-s-fixture-manifest.mjs test-v02-t-evaluation.mjs test-v02-u-evaluation.mjs test-v02-u-fixture-manifest.mjs test-v02-v-evaluation.mjs test-v02-w.mjs",
    "test:v02-r": "node test-v02-r.mjs",
    "prepare:v02-s-model": "node prepare-v02-s-model.mjs",
    "test:v02-s": "node run-v02-s-matrix.mjs",
    "summarize:v02-s": "node generate-v02-s-summary.mjs",
    "test:v02-t": "node run-v02-t-matrix.mjs",
    "summarize:v02-t": "node generate-v02-t-summary.mjs",
    "test:v02-u": "node run-v02-u-matrix.mjs",
    "summarize:v02-u": "node generate-v02-u-summary.mjs",
    "test:v02-v": "node run-v02-v-matrix.mjs",
    "summarize:v02-v": "node generate-v02-v-summary.mjs",
    "test:v02-w": "node run-v02-w.mjs",
    "summarize:v02-w": "node generate-v02-w-summary.mjs",
    "test:native": "node run-compare.mjs --engine native",
    "test:wasm": "node run-compare.mjs --engine wasm",
    "test:compare": "node run-compare.mjs --engine both",
    "test:hotwords": "node run-compare.mjs --engine wasm --fixture fixtures/generated/bagging-boosting.wav --hotwords fixtures/hotwords-bagging-boosting.txt"
  },
  "dependencies": {
    "sherpa-onnx": "1.13.4",
    "sherpa-onnx-node": "1.13.4"
  }
}
